<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/white"
    android:paddingLeft="2dp"
    android:paddingRight="2dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        app:cardElevation="2dp"
        android:id="@+id/central_box"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:id="@+id/central_top"
                android:orientation="horizontal"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="@dimen/activity_vertical_margin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:gravity="center"
                    android:layout_centerInParent="true"
                    android:orientation="horizontal"
                    android:layout_marginLeft="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentStart="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:ignore="UseCompoundDrawables">

                    <ImageView
                        android:contentDescription="@string/app_name"
                        android:id="@+id/central_img"
                        android:layout_width="50dp"
                        android:layout_height="50dp" />

                    <TextView
                        android:textColor="@color/colorPrimary"
                        style="?android:attr/textAppearanceMedium"
                        android:layout_marginLeft="5dp"
                        android:layout_marginStart="5dp"
                        android:id="@+id/central_title_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:layout_centerInParent="true"
                    android:layout_alignParentRight="true"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:ignore="RelativeOverlap">

                    <FrameLayout
                        android:clickable="true"
                        android:id="@+id/central_edit_frame"
                        android:layout_marginRight="21dp"
                        android:layout_marginEnd="21dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/central_edit_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:drawableLeft="@mipmap/ic_create_black_24dp"
                            android:drawableStart="@mipmap/ic_create_black_24dp"
                            android:clickable="false"
                            android:focusable="false"
                            android:gravity="center"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:background="@null"/>

                    </FrameLayout>

                    <FrameLayout
                        android:clickable="true"
                        android:id="@+id/central_delete_frame"
                        android:layout_marginRight="21dp"
                        android:layout_marginEnd="21dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/central_delete_txt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:drawableLeft="@mipmap/ic_delete_black_24dp"
                            android:drawableStart="@mipmap/ic_delete_black_24dp"
                            android:clickable="false"
                            android:focusable="false"
                            android:gravity="center"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:background="@null"/>

                    </FrameLayout>

                </LinearLayout>

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/central_bottom"
                android:visibility="gone"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/central_username_layout"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="@string/central_username"
                            android:layout_marginLeft="10dp"
                            android:layout_marginStart="10dp"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentLeft="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <FrameLayout
                            android:id="@+id/central_copy_username"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentEnd="true"
                            android:layout_marginRight="21dp"
                            android:layout_marginEnd="21dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:ignore="RelativeOverlap">

                            <TextView
                                android:id="@+id/central_copy_username_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:drawableLeft="@mipmap/ic_content_copy_black_24dp"
                                android:drawableStart="@mipmap/ic_content_copy_black_24dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:gravity="center"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:background="@null"/>

                        </FrameLayout>

                    </RelativeLayout>

                    <TextView
                        android:textSize="12sp"
                        android:id="@+id/central_username"
                        android:textColor="@color/colorAccent"
                        android:layout_marginLeft="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/central_mail_layout"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="@string/central_mail"
                            android:layout_marginLeft="10dp"
                            android:layout_marginStart="10dp"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentLeft="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <FrameLayout
                            android:id="@+id/central_copy_mail"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentEnd="true"
                            android:layout_marginRight="21dp"
                            android:layout_marginEnd="21dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:ignore="RelativeOverlap">

                            <TextView
                                android:id="@+id/central_copy_mail_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:drawableLeft="@mipmap/ic_content_copy_black_24dp"
                                android:drawableStart="@mipmap/ic_content_copy_black_24dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:gravity="center"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:background="@null"/>

                        </FrameLayout>

                    </RelativeLayout>

                    <TextView
                        android:textSize="12sp"
                        android:id="@+id/central_mail"
                        android:textColor="@color/colorAccent"
                        android:layout_marginLeft="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/central_mdp_layout"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="@string/central_mdp"
                            android:layout_marginLeft="10dp"
                            android:layout_marginStart="10dp"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentLeft="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <FrameLayout
                            android:id="@+id/central_copy_mdp"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentEnd="true"
                            android:layout_marginRight="21dp"
                            android:layout_marginEnd="21dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:ignore="RelativeOverlap">

                            <TextView
                                android:id="@+id/central_copy_mdp_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:drawableLeft="@mipmap/ic_content_copy_black_24dp"
                                android:drawableStart="@mipmap/ic_content_copy_black_24dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:gravity="center"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:background="@null"/>

                        </FrameLayout>

                    </RelativeLayout>

                    <TextView
                        android:textSize="12sp"
                        android:id="@+id/central_mdp"
                        android:textColor="@color/colorAccent"
                        android:layout_marginLeft="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/central_notes_layout"
                    android:orientation="vertical"
                    android:layout_marginBottom="@dimen/activity_vertical_margin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:text="@string/central_notes"
                            android:layout_marginLeft="10dp"
                            android:layout_marginStart="10dp"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentLeft="true"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <FrameLayout
                            android:id="@+id/central_copy_notes"
                            android:layout_alignParentRight="true"
                            android:layout_alignParentEnd="true"
                            android:layout_marginRight="21dp"
                            android:layout_marginEnd="21dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:ignore="RelativeOverlap">

                            <TextView
                                android:id="@+id/central_copy_notes_txt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:drawableLeft="@mipmap/ic_content_copy_black_24dp"
                                android:drawableStart="@mipmap/ic_content_copy_black_24dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:gravity="center"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:background="@null"/>

                        </FrameLayout>

                    </RelativeLayout>

                    <TextView
                        android:textSize="12sp"
                        android:id="@+id/central_notes"
                        android:textColor="@color/colorAccent"
                        android:layout_marginLeft="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <TextView
                    android:id="@+id/central_date"
                    android:gravity="center"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:textSize="12sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>